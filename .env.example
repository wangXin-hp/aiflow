# 本地开发示例；复制为 .env 后替换 JWT_SECRET，禁止提交真实密钥。
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000

POSTGRES_DB=aiflow
POSTGRES_USER=aiflow
POSTGRES_PASSWORD=aiflow
DATABASE_URL=postgresql://aiflow:aiflow@127.0.0.1:5432/aiflow
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
WEB_PUBLIC_URL=http://127.0.0.1:5173

JWT_SECRET=replace-me
JWT_EXPIRES_IN_SECONDS=604800

# 登录和重发同时按 IP、规范化邮箱计数；窗口单位为毫秒，数值均为正整数。
AUTH_LOGIN_RATE_LIMIT=5
AUTH_LOGIN_RATE_WINDOW_MS=60000
AUTH_RESEND_RATE_LIMIT=3
AUTH_RESEND_RATE_WINDOW_MS=900000

# console 仅允许 development/test；生产环境必须改为 smtp 并填入下列配置。
AUTH_EMAIL_MODE=console
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

ARK_API_KEY=
ARK_MODEL_ID=
ARK_EMBEDDING_MODEL_ID=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

RUN_NODE_TIMEOUT_MS=30000
RUN_TOTAL_TIMEOUT_MS=300000
RUN_MAX_NODES=100
RUN_MAX_CONCURRENT=4
RUN_EVENT_MAX_BYTES=65536
RUN_HTTP_ALLOWED_HOSTS=
