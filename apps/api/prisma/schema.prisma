// 生成客户端参与 TypeScript 构建；生成物不提交，安装后须执行 db:generate。
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// 邮箱由后续认证服务规范化；数据库只负责唯一约束，不修改输入内容。
model User {
  id                         String    @id @default(uuid()) @db.Uuid
  email                      String    @unique
  passwordHash               String
  name                       String?
  avatarUrl                  String?
  emailVerifiedAt            DateTime?
  verificationTokenHash      String?
  verificationTokenExpiresAt DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  workflows                  Workflow[]
  knowledgeBases             KnowledgeBase[]
  knowledgeDocuments         KnowledgeDocument[]
  runs                       WorkflowRun[]
}

// 草稿通过 revision 乐观锁更新；archivedAt 仅做软归档，避免破坏历史版本和运行关联。
model Workflow {
  id          String    @id @default(uuid()) @db.Uuid
  ownerId     String    @db.Uuid
  name        String
  description String    @default("")
  definition  Json
  revision    Int       @default(1)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  versions    WorkflowVersion[]
  runs        WorkflowRun[]

  // owner、归档状态与稳定游标字段组成工作流列表的主要查询路径。
  @@index([ownerId, archivedAt, createdAt, id])
  @@unique([id, ownerId])
}

// 版本快照只允许追加；唯一版本号约束为后续发布流程保留不可变历史。
model WorkflowVersion {
  id                 String   @id @default(uuid()) @db.Uuid
  workflowId         String   @db.Uuid
  version            Int
  definitionSnapshot Json
  createdAt          DateTime @default(now())
  workflow           Workflow @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  runs               WorkflowRun[]

  @@unique([workflowId, version])
  @@unique([id, workflowId])
  @@index([workflowId, createdAt])
}

model KnowledgeBase {
  id                String   @id @default(uuid()) @db.Uuid
  ownerId           String   @db.Uuid
  name              String
  description       String   @default("")
  qdrantCollection  String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  owner             User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  documents         KnowledgeDocument[]

  // 复合候选键供文档外键同时校验知识库 ID 与租户归属。
  @@unique([id, ownerId])
  @@index([ownerId, createdAt, id])
}

enum KnowledgeDocumentStatus {
  PENDING
  INDEXING
  INDEXED
  FAILED
}

// PostgreSQL 只保存文档索引元数据；向量及分块正文由 Qdrant 管理。
model KnowledgeDocument {
  id              String                  @id @default(uuid()) @db.Uuid
  ownerId         String                  @db.Uuid
  knowledgeBaseId String                  @db.Uuid
  name            String
  contentSummary  String?
  indexingStatus  KnowledgeDocumentStatus @default(PENDING)
  version         Int                     @default(1)
  chunkCount      Int                     @default(0)
  errorMessage    String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  owner           User                    @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  knowledgeBase   KnowledgeBase           @relation(fields: [knowledgeBaseId, ownerId], references: [id, ownerId], onDelete: Restrict)

  // ownerId 保留直接过滤路径；复合外键从数据库层禁止文档跨租户挂载知识库。
  @@index([ownerId, createdAt, id])
  @@index([knowledgeBaseId, ownerId, createdAt, id])
}

enum WorkflowRunStatus {
  QUEUED
  RUNNING
  CANCELLING
  SUCCEEDED
  FAILED
  CANCELLED
  INTERRUPTED
}

enum NodeRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
  CANCELLED
}

// 运行保存启动时的图快照；草稿后续修改不会改变执行或历史详情。
model WorkflowRun {
  id                 String            @id @default(uuid()) @db.Uuid
  ownerId            String            @db.Uuid
  workflowId         String            @db.Uuid
  workflowVersionId  String?           @db.Uuid
  definitionSnapshot Json
  input              Json
  output             Json?
  status             WorkflowRunStatus @default(QUEUED)
  errorCode          String?
  errorMessage       String?
  createdAt          DateTime          @default(now())
  startedAt          DateTime?
  finishedAt         DateTime?
  owner              User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  workflow           Workflow          @relation(fields: [workflowId, ownerId], references: [id, ownerId], onDelete: Restrict)
  workflowVersion    WorkflowVersion?  @relation(fields: [workflowVersionId, workflowId], references: [id, workflowId], onDelete: Restrict)
  nodes              NodeRun[]
  events             RunEvent[]

  @@index([ownerId, createdAt, id])
  @@index([workflowId, createdAt, id])
  @@index([status, createdAt])
}

model NodeRun {
  id           String        @id @default(uuid()) @db.Uuid
  runId        String        @db.Uuid
  nodeId       String
  nodeType     String
  status       NodeRunStatus @default(PENDING)
  input        Json?
  output       Json?
  errorCode    String?
  errorMessage String?
  startedAt    DateTime?
  finishedAt   DateTime?
  elapsedMs    Int?
  run          WorkflowRun   @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@unique([runId, nodeId])
  @@index([runId, status])
}

// 全局自增 ID 是可重放 SSE 游标；事件只追加，payload 由应用层脱敏。
model RunEvent {
  id        BigInt      @id @default(autoincrement())
  runId     String      @db.Uuid
  nodeId    String?
  type      String
  level     String
  payload   Json
  createdAt DateTime    @default(now())
  run       WorkflowRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@index([runId, id])
}
