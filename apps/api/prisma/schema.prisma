// 生成客户端参与 TypeScript 构建；生成物不提交，安装后须执行 db:generate。
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// 邮箱由后续认证服务规范化；数据库只负责唯一约束，不修改输入内容。
model User {
  id                         String    @id @default(uuid()) @db.Uuid
  email                      String    @unique
  passwordHash               String
  name                       String?
  avatarUrl                  String?
  emailVerifiedAt            DateTime?
  verificationTokenHash      String?
  verificationTokenExpiresAt DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  workflows                  Workflow[]
  knowledgeBases             KnowledgeBase[]
  knowledgeDocuments         KnowledgeDocument[]
}

// 草稿通过 revision 乐观锁更新；archivedAt 仅做软归档，避免破坏历史版本和运行关联。
model Workflow {
  id          String    @id @default(uuid()) @db.Uuid
  ownerId     String    @db.Uuid
  name        String
  description String    @default("")
  definition  Json
  revision    Int       @default(1)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  versions    WorkflowVersion[]

  // owner、归档状态与稳定游标字段组成工作流列表的主要查询路径。
  @@index([ownerId, archivedAt, createdAt, id])
}

// 版本快照只允许追加；唯一版本号约束为后续发布流程保留不可变历史。
model WorkflowVersion {
  id                 String   @id @default(uuid()) @db.Uuid
  workflowId         String   @db.Uuid
  version            Int
  definitionSnapshot Json
  createdAt          DateTime @default(now())
  workflow           Workflow @relation(fields: [workflowId], references: [id], onDelete: Restrict)

  @@unique([workflowId, version])
  @@index([workflowId, createdAt])
}

model KnowledgeBase {
  id                String   @id @default(uuid()) @db.Uuid
  ownerId           String   @db.Uuid
  name              String
  description       String   @default("")
  qdrantCollection  String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  owner             User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  documents         KnowledgeDocument[]

  @@index([ownerId, createdAt, id])
}

enum KnowledgeDocumentStatus {
  PENDING
  INDEXING
  INDEXED
  FAILED
}

// PostgreSQL 只保存文档索引元数据；向量及分块正文由 Qdrant 管理。
model KnowledgeDocument {
  id              String                  @id @default(uuid()) @db.Uuid
  ownerId         String                  @db.Uuid
  knowledgeBaseId String                  @db.Uuid
  name            String
  contentSummary  String?
  indexingStatus  KnowledgeDocumentStatus @default(PENDING)
  version         Int                     @default(1)
  chunkCount      Int                     @default(0)
  errorMessage    String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  owner           User                    @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  knowledgeBase   KnowledgeBase           @relation(fields: [knowledgeBaseId], references: [id], onDelete: Restrict)

  // ownerId 是直接的安全过滤边界，knowledgeBaseId 支持库内文档分页。
  @@index([ownerId, createdAt, id])
  @@index([knowledgeBaseId, createdAt, id])
}
