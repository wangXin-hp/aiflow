{
    "name": "@aiflow/webapp",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.development --env-file-if-exists=.env.local --env-file-if-exists=.env.development.local --import tsx server/index.ts --dev",
        "build": "vite build",
        "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.production --env-file-if-exists=.env.local --env-file-if-exists=.env.production.local --import tsx server/index.ts",
        "typecheck": "tsc --noEmit",
        "db:generate": "prisma generate"
    },
    "dependencies": {
        "@aiflow/ai-engine": "workspace:*",
        "@prisma/adapter-pg": "^7.2.0",
        "@prisma/client": "^7.2.0",
        "react": "19.2.0",
        "react-dom": "19.2.0",
        "lucide-react": "^0.555.0",
        "sonner": "^2.0.7",
        "clsx": "^2.1.1",
        "tailwind-merge": "^3.4.0",
        "pg": "^8.16.3",
        "prisma": "^7.2.0",
        "@aiflow/react-server": "workspace:*",
        "hono": "^4.13.18",
        "react-router": "^7.13.0",
        "tsx": "^4.23.15"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "4.1.17",
        "tailwindcss": "4.1.18",
        "@types/node": "20.19.25",
        "@types/react": "19.2.7",
        "@types/react-dom": "19.2.3",
        "@types/pg": "^8.16.0",
        "dotenv": "^16.4.5",
        "vite": "8.3.7",
        "@vitejs/plugin-react": "^6.0.0"
    },
    "type": "module"
}
